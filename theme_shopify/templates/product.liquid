{% render 'breadcrumb' %}

<div class="product-page">
  <div class="container">
    <div class="product-layout">
      <!-- Product Images -->
      <div class="product-images">
        <div class="product-gallery">
          {% if product.images.size > 0 %}
            <div class="product-gallery__main" id="main-image">
              <img 
                src="{{ product.featured_image | img_url: '1000x' }}" 
                alt="{{ product.title | escape }}"
                loading="eager"
                id="featured-image"
              >
            </div>

            {% if product.images.size > 1 %}
              <div class="product-gallery__thumbs">
                {% for image in product.images %}
                  <button 
                    class="gallery-thumb {% if forloop.first %}active{% endif %}"
                    onclick="changeImage('{{ image | img_url: '1000x' }}')"
                  >
                    <img src="{{ image | img_url: '150x' }}" alt="{{ product.title | escape }}">
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <div class="product-placeholder">
              <svg width="200" height="200" viewBox="0 0 200 200" fill="#f3f4f6">
                <rect width="200" height="200" fill="#f3f4f6"/>
                <path d="M100 60v80M60 100h80" stroke="#9ca3af" stroke-width="4"/>
              </svg>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Product Info -->
      <div class="product-info">
        {% if product.vendor %}
          <p class="product-vendor">{{ product.vendor }}</p>
        {% endif %}

        <h1 class="product-title">{{ product.title }}</h1>

        <!-- Price -->
        <div class="product-price">
          {% if product.compare_at_price > product.price %}
            <span class="price price--sale">{{ product.price | money }}</span>
            <span class="price price--compare">{{ product.compare_at_price | money }}</span>
            <span class="price-badge">
              -{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
            </span>
          {% else %}
            <span class="price">{{ product.price | money }}</span>
          {% endif %}
        </div>

        <!-- Rating -->
        {% if product.metafields.reviews.rating.value %}
          <div class="product-rating">
            {% render 'star-rating', rating: product.metafields.reviews.rating.value %}
            <span class="rating-text">
              {{ product.metafields.reviews.rating.value }} ({{ product.metafields.reviews.rating_count.value }} avis)
            </span>
          </div>
        {% endif %}

        <!-- Description -->
        {% if product.description != blank %}
          <div class="product-description">
            {{ product.description }}
          </div>
        {% endif %}

        <!-- Product Form -->
        <form action="/cart/add" method="post" id="product-form">
          <!-- Variants -->
          {% unless product.has_only_default_variant %}
            <div class="product-variants">
              {% for option in product.options_with_values %}
                <div class="variant-option">
                  <label>{{ option.name }}</label>
                  <select 
                    name="option{{ forloop.index }}" 
                    class="variant-select"
                    onchange="updateVariant()"
                  >
                    {% for value in option.values %}
                      <option value="{{ value }}">{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <!-- Quantity -->
          <div class="product-quantity">
            <label>Quantité</label>
            <div class="quantity-selector">
              <button type="button" class="qty-btn" onclick="decreaseQty()">−</button>
              <input type="number" name="quantity" value="1" min="1" id="quantity-input">
              <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
            </div>
          </div>

          <!-- Hidden variant ID -->
          <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Add to Cart -->
          <div class="product-actions">
            <button 
              type="submit" 
              class="btn btn-primary btn-block"
              {% unless product.available %}disabled{% endunless %}
            >
              {% if product.available %}
                Ajouter au panier
              {% else %}
                Rupture de stock
              {% endif %}
            </button>
          </div>
        </form>

        <!-- Product Meta -->
        <div class="product-meta">
          {% if product.available %}
            <div class="meta-item">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6z"/>
              </svg>
              <span>En stock</span>
            </div>
          {% endif %}
          
          <div class="meta-item">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
            </svg>
            <span>Livraison 24-48h</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {% if product.collections.first %}
      <div class="related-products section-spacing">
        <h2 class="section-title">Produits similaires</h2>
        <div class="product-grid">
          {% for related_product in product.collections.first.products limit: 4 %}
            {% unless related_product.id == product.id %}
              {% render 'product-card', product: related_product %}
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
function changeImage(src) {
  document.getElementById('featured-image').src = src;
  
  // Update active thumb
  document.querySelectorAll('.gallery-thumb').forEach(thumb => {
    thumb.classList.remove('active');
  });
  event.target.closest('.gallery-thumb').classList.add('active');
}

function increaseQty() {
  const input = document.getElementById('quantity-input');
  input.value = parseInt(input.value) + 1;
}

function decreaseQty() {
  const input = document.getElementById('quantity-input');
  if (parseInt(input.value) > 1) {
    input.value = parseInt(input.value) - 1;
  }
}

// Variant selection
function updateVariant() {
  // This would need more complex logic for multi-variant products
  // For now, it's a placeholder
}

// Add to cart with AJAX
document.getElementById('product-form').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const formData = new FormData(this);
  
  fetch('/cart/add.js', {
    method: 'POST',
    body: formData
  })
  .then(response => response.json())
  .then(() => {
    window.dispatchEvent(new CustomEvent('cart-open'));
  })
  .catch(error => console.error('Error:', error));
});
</script>
