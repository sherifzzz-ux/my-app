<div 
  class="cart-drawer" 
  x-data="{ open: false }" 
  x-show="open"
  x-cloak
  @cart-open.window="open = true"
>
  <div class="cart-drawer__overlay" @click="open = false"></div>
  
  <div class="cart-drawer__content">
    <!-- Header -->
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Panier ({{ cart.item_count }})</h2>
      <button 
        class="cart-drawer__close" 
        @click="open = false"
        aria-label="Fermer le panier"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Cart Items -->
    <div class="cart-drawer__items">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="cart-item" data-line-item="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-item__image">
              {% if item.image %}
                <img 
                  src="{{ item.image | img_url: '200x' }}" 
                  alt="{{ item.title | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </a>

            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title">
                {{ item.product.title }}
              </a>
              
              {% if item.variant.title != 'Default Title' %}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {% endif %}

              <div class="cart-item__price">
                {% if item.original_price > item.final_price %}
                  <span class="price price--sale">{{ item.final_price | money }}</span>
                  <span class="price price--compare">{{ item.original_price | money }}</span>
                {% else %}
                  <span class="price">{{ item.final_price | money }}</span>
                {% endif %}
              </div>

              <!-- Quantity -->
              <div class="cart-item__quantity">
                <button 
                  class="qty-btn"
                  onclick="updateCartItem({{ forloop.index }}, {{ item.quantity | minus: 1 }})"
                  {% if item.quantity <= 1 %}disabled{% endif %}
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M3 8h10"/>
                  </svg>
                </button>
                
                <input 
                  type="number" 
                  class="qty-input"
                  value="{{ item.quantity }}"
                  min="1"
                  onchange="updateCartItem({{ forloop.index }}, this.value)"
                >
                
                <button 
                  class="qty-btn"
                  onclick="updateCartItem({{ forloop.index }}, {{ item.quantity | plus: 1 }})"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 3v10M3 8h10"/>
                  </svg>
                </button>
              </div>
            </div>

            <button 
              class="cart-item__remove"
              onclick="removeCartItem({{ forloop.index }})"
              aria-label="Supprimer"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 6l8 8M6 14l8-8"/>
              </svg>
            </button>
          </div>
        {% endfor %}
      {% else %}
        <div class="cart-empty">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 8h8l6.4 32a4 4 0 004 3.2h28.8a4 4 0 004-3.2L62 16H16"/>
          </svg>
          <p>Votre panier est vide</p>
          <a href="/collections/all" class="btn btn-primary" @click="open = false">
            Continuer les achats
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Footer -->
    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <!-- Subtotal -->
        <div class="cart-summary">
          <div class="cart-summary__row">
            <span>Sous-total</span>
            <span class="cart-total">{{ cart.total_price | money }}</span>
          </div>
          
          {% if settings.free_shipping_threshold %}
            {% assign threshold = settings.free_shipping_threshold | times: 1 %}
            {% if cart.total_price < threshold %}
              {% assign remaining = threshold | minus: cart.total_price %}
              <p class="cart-shipping-message">
                Plus que {{ remaining | money }} pour la livraison gratuite !
              </p>
              <div class="progress-bar">
                <div 
                  class="progress-fill" 
                  style="width: {{ cart.total_price | times: 100 | divided_by: threshold }}%"
                ></div>
              </div>
            {% else %}
              <p class="cart-shipping-message success">
                🎉 Livraison gratuite !
              </p>
            {% endif %}
          {% endif %}
        </div>

        <!-- Actions -->
        <div class="cart-actions">
          <a href="/checkout" class="btn btn-primary btn-block">
            Commander
          </a>
          <a href="/cart" class="btn btn-secondary btn-block">
            Voir le panier
          </a>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
// Cart functionality
function addToCart(event, variantId) {
  event.preventDefault();
  event.stopPropagation();
  
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(response => response.json())
  .then(() => {
    window.location.reload(); // Refresh to update cart
  })
  .catch(error => console.error('Error:', error));
}

function updateCartItem(line, quantity) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ line, quantity: parseInt(quantity) })
  })
  .then(response => response.json())
  .then(() => {
    window.location.reload();
  })
  .catch(error => console.error('Error:', error));
}

function removeCartItem(line) {
  updateCartItem(line, 0);
}

// Cart toggle
document.addEventListener('DOMContentLoaded', () => {
  const cartToggle = document.querySelector('[data-cart-toggle]');
  if (cartToggle) {
    cartToggle.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('cart-open'));
    });
  }
});
</script>
