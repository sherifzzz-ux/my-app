{%- comment -%}
  FlawlessBeauty - Product Card
  Usage: {% render 'flawless-beauty-product-card', product: product %}
{%- endcomment -%}

{%- liquid
  assign product_url = product.url | default: '#'
  assign product_image = product.featured_media.preview_image | default: product.featured_image
  assign product_title = product.title | escape
  assign on_sale = product.compare_at_price > product.price
  assign price_formatted = product.price | money
  assign compare_price_formatted = product.compare_at_price | money
-%}

<div class="card-wrapper">
  <div class="card card--product">
    {%- comment -%} Product Image {%- endcomment -%}
    <div class="card__media">
      <a href="{{ product_url }}" class="card__media-link">
        {%- if product_image -%}
          {{ product_image | image_url: width: 600 | image_tag: 
            loading: 'lazy',
            class: 'card__image',
            alt: product_title,
            widths: '200, 300, 400, 600, 800'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'card__image placeholder-svg' }}
        {%- endif -%}
      </a>
      
      {%- comment -%} Product Badge {%- endcomment -%}
      {% render 'flawless-beauty-product-badge', product: product %}
    </div>

    {%- comment -%} Product Content {%- endcomment -%}
    <div class="card__content">
      <a href="{{ product_url }}" class="card__heading-link">
        <h3 class="card__heading">{{ product_title }}</h3>
      </a>

      {%- comment -%} Product Price {%- endcomment -%}
      <div class="price">
        {%- if on_sale -%}
          <span class="price__sale">{{ price_formatted }}</span>
          <span class="price__compare">{{ compare_price_formatted }}</span>
        {%- else -%}
          <span class="price__regular">{{ price_formatted }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Product Description (Optional) {%- endcomment -%}
      {%- if product.description != blank and section.settings.show_description -%}
        <div class="card__description">
          {{ product.description | strip_html | truncate: 80 }}
        </div>
      {%- endif -%}

      {%- comment -%} Product Actions {%- endcomment -%}
      <div class="card__actions">
        {%- if product.available -%}
          <button
            type="button"
            class="card__button button--primary"
            onclick="addToCart({{ product.selected_or_first_available_variant.id }})"
          >
            Ajouter au panier
          </button>
        {%- else -%}
          <button
            type="button"
            class="card__button button--secondary"
            disabled
          >
            Épuisé
          </button>
        {%- endif -%}
        
        <a href="{{ product_url }}" class="card__button card__button--secondary">
          Voir détails
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .card-wrapper {
    height: 100%;
  }

  .card {
    position: relative;
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(245, 232, 241);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px -4px rgba(247, 146, 204, 0.15);
    border-color: rgb(247, 146, 204);
  }

  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3/4;
    background-color: rgb(250, 242, 247);
  }

  .card__media-link {
    display: block;
    height: 100%;
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover .card__image {
    transform: scale(1.05);
  }

  .card__content {
    padding: 1rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card__heading-link {
    text-decoration: none;
    color: inherit;
  }

  .card__heading {
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(12, 10, 9);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .price__regular {
    font-size: 1.125rem;
    font-weight: 700;
    color: rgb(12, 10, 9);
  }

  .price__sale {
    font-size: 1.125rem;
    font-weight: 700;
    color: rgb(239, 68, 68);
  }

  .price__compare {
    font-size: 0.875rem;
    color: rgb(115, 115, 115);
    text-decoration: line-through;
  }

  .card__description {
    font-size: 0.875rem;
    color: rgb(115, 115, 115);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .card__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .card__button {
    flex: 1;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  .button--primary {
    background: linear-gradient(135deg, rgb(247, 146, 204), rgb(252, 174, 217));
    color: rgb(255, 255, 255);
  }

  .button--primary:hover {
    box-shadow: 0 0 30px rgba(247, 146, 204, 0.4);
    transform: translateY(-2px);
  }

  .card__button--secondary {
    background: transparent;
    border: 1px solid rgb(245, 232, 241);
    color: rgb(12, 10, 9);
  }

  .card__button--secondary:hover {
    background-color: rgb(250, 242, 247);
    border-color: rgb(247, 146, 204);
    color: rgb(247, 146, 204);
  }

  .button--primary:disabled,
  .button--secondary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .card__content {
      padding: 0.75rem;
    }

    .card__heading {
      font-size: 0.875rem;
    }

    .price__regular,
    .price__sale {
      font-size: 1rem;
    }

    .card__button {
      font-size: 0.8125rem;
      padding: 0.625rem 0.75rem;
    }

    .card__actions {
      flex-direction: column;
    }
  }
</style>

<script>
  function addToCart(variantId) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(response => response.json())
    .then(data => {
      // Actualiser le compteur du panier
      if (window.updateCartCount) {
        window.updateCartCount();
      }
      // Afficher notification (optionnel)
      alert('Produit ajouté au panier !');
    })
    .catch(error => {
      console.error('Erreur:', error);
      alert('Une erreur est survenue. Veuillez réessayer.');
    });
  }
</script>
