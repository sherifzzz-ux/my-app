</div>

<style>
  .footer-nav {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .footer-nav__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-nav__heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: rgb(12, 10, 9);
    margin-bottom: 1rem;
    font-family: 'Playfair Display', serif;
  }

  .footer-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-nav__list li {
    margin-bottom: 0.75rem;
  }

  .footer-nav__list a {
    color: rgb(115, 115, 115);
    text-decoration: none;
    font-size: 0.875rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-block;
  }

  .footer-nav__list a:hover {
    color: rgb(247, 146, 204);
    transform: translateX(4px);
  }

  .footer-nav__list--contact li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-nav__icon {
    flex-shrink: 0;
    color: rgb(247, 146, 204);
  }

  .footer-nav__text {
    font-size: 0.875rem;
    color: rgb(115, 115, 115);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .footer-nav__form-group {
    display: flex;
    gap: 0.5rem;
  }

  .footer-nav__input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(245, 232, 241);
    border-radius: 0.75rem;
    font-size: 0.875rem;
    background-color: rgb(248, 237, 244);
    color: rgb(12, 10, 9);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-nav__input:focus {
    outline: none;
    border-color: rgb(247, 146, 204);
    box-shadow: 0 0 0 3px rgba(247, 146, 204, 0.1);
  }

  .footer-nav__button {
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, rgb(247, 146, 204), rgb(252, 174, 217));
    color: rgb(255, 255, 255);
    border: none;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
  }

  .footer-nav__button:hover {
    box-shadow: 0 0 30px rgba(247, 146, 204, 0.4);
    transform: translateY(-2px);
  }

  .footer-nav__payment {
    padding: 2rem 0;
    border-top: 1px solid rgb(245, 232, 241);
    border-bottom: 1px solid rgb(245, 232, 241);
    text-align: center;
  }

  .footer-nav__payment-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(115, 115, 115);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-nav__payment-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-nav__payment-icon {
    height: 2rem;
    width: auto;
    opacity: 0.6;
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-nav__payment-icon:hover {
    opacity: 1;
  }

  .footer-nav__payment-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(115, 115, 115);
    padding: 0.5rem 1rem;
    border: 1px solid rgb(245, 232, 241);
    border-radius: 0.5rem;
    background-color: rgb(250, 242, 247);
    height: 2rem;
    display: flex;
    align-items: center;
  }

  .footer-nav__social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .footer-nav__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background-color: rgb(250, 242, 247);
    color: rgb(12, 10, 9);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-nav__social-link:hover {
    background: linear-gradient(135deg, rgb(247, 146, 204), rgb(252, 174, 217));
    color: rgb(255, 255, 255);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .footer-nav {
      padding: 2rem 1rem;
    }

    .footer-nav__grid {
      gap: 2rem;
      grid-template-columns: 1fr;
    }

    .footer-nav__form-group {
      flex-direction: column;
    }

    .footer-nav__button {
      width: 100%;
    }

    .footer-nav__payment-icons {
      gap: 1rem;
    }
  }
</style>
