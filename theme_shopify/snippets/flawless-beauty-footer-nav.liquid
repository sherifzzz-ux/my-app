{%- comment -%}
  FlawlessBeauty - Footer Navigation
  Footer avec blocs catégories, infos pratiques, et paiement sécurisé
{%- endcomment -%}

<div class="footer-nav">
  <div class="footer-nav__grid">
    {%- comment -%} Colonne 1: Catégories {%- endcomment -%}
    <div class="footer-nav__column">
      <h3 class="footer-nav__heading">Catégories</h3>
      <ul class="footer-nav__list">
        <li><a href="/collections/cadeau-promo">Cadeau & Promo</a></li>
        <li><a href="/collections/cheveux">Cheveux</a></li>
        <li><a href="/collections/corps-bain">Corps & Bain</a></li>
        <li><a href="/collections/maquillage">Maquillage</a></li>
        <li><a href="/collections/parapharmacie">Parapharmacie</a></li>
      </ul>
    </div>

    {%- comment -%} Colonne 2: Infos pratiques {%- endcomment -%}
    <div class="footer-nav__column">
      <h3 class="footer-nav__heading">Infos pratiques</h3>
      <ul class="footer-nav__list">
        <li><a href="/pages/marques">Nos Marques</a></li>
        <li><a href="/account">Mon compte</a></li>
        <li><a href="/blogs/news">Blog</a></li>
        <li><a href="/pages/conditions">Conditions</a></li>
        <li><a href="/pages/livraison">Livraison</a></li>
        <li><a href="/pages/cookies">Politique cookies</a></li>
      </ul>
    </div>

    {%- comment -%} Colonne 3: Contact {%- endcomment -%}
    <div class="footer-nav__column">
      <h3 class="footer-nav__heading">Contact</h3>
      <ul class="footer-nav__list footer-nav__list--contact">
        <li>
          <svg class="footer-nav__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>+221 XX XXX XX XX</span>
        </li>
        <li>
          <svg class="footer-nav__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>contact@flawlessbeauty.sn</span>
        </li>
        <li>
          <svg class="footer-nav__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Dakar, Sénégal</span>
        </li>
      </ul>
    </div>

    {%- comment -%} Colonne 4: Newsletter {%- endcomment -%}
    <div class="footer-nav__column">
      <h3 class="footer-nav__heading">Newsletter</h3>
      <p class="footer-nav__text">Recevez nos offres exclusives et nouveautés</p>
      <form action="/contact#ContactFooter" method="post" class="footer-nav__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="footer-nav__form-group">
          <input 
            type="email" 
            name="contact[email]" 
            placeholder="Votre email"
            class="footer-nav__input"
            required
          >
          <button type="submit" class="footer-nav__button">
            S'abonner
          </button>
        </div>
      </form>
    </div>
  </div>

  {%- comment -%} Paiement sécurisé {%- endcomment -%}
  <div class="footer-nav__payment">
    <h4 class="footer-nav__payment-title">Paiement sécurisé</h4>
    <div class="footer-nav__payment-icons">
      <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" class="footer-nav__payment-icon">
      <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="Mastercard" class="footer-nav__payment-icon">
      <span class="footer-nav__payment-icon footer-nav__payment-text">Orange Money</span>
      <span class="footer-nav__payment-icon footer-nav__payment-text">Wave</span>
    </div>
  </div>

  {%- comment -%} Réseaux sociaux {%- endcomment -%}
