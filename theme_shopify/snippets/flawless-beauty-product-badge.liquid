{%- comment -%}
  FlawlessBeauty - Product Badge
  Usage: {% render 'flawless-beauty-product-badge', product: product %}
{%- endcomment -%}

{%- liquid
  assign on_sale = false
  assign is_new = false
  assign low_stock = false
  
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  
  if product.published_at
    assign days_since_publish = 'now' | date: '%s' | minus: product.published_at | date: '%s' | divided_by: 86400
    if days_since_publish < 30
      assign is_new = true
    endif
  endif
  
  if product.selected_or_first_available_variant.inventory_quantity
    if product.selected_or_first_available_variant.inventory_quantity < 10 and product.selected_or_first_available_variant.inventory_quantity > 0
      assign low_stock = true
    endif
  endif
-%}

<div class="card__badge">
  {%- if on_sale -%}
    <span class="badge badge--promo">
      {%- liquid
        assign savings = product.compare_at_price | minus: product.price
        assign savings_percent = savings | times: 100 | divided_by: product.compare_at_price | round
      -%}
      -{{ savings_percent }}%
    </span>
  {%- elsif is_new -%}
    <span class="badge badge--new">
      Nouveau
    </span>
  {%- elsif low_stock -%}
    <span class="badge badge--stock-low">
      Stock limité
    </span>
  {%- endif -%}
</div>

<style>
  .card__badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .badge--promo {
    background: var(--gradient-urgent, linear-gradient(135deg, rgb(239, 68, 68), rgb(241, 123, 100)));
    color: rgb(255, 255, 255);
    box-shadow: var(--shadow-soft, 0 2px 20px -2px rgba(239, 68, 68, 0.3));
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .badge--new {
    background: var(--gradient-primary, linear-gradient(135deg, rgb(247, 146, 204), rgb(252, 174, 217)));
    color: rgb(255, 255, 255);
    box-shadow: var(--shadow-soft, 0 2px 20px -2px rgba(247, 146, 204, 0.3));
  }

  .badge--stock-low {
    background-color: rgb(251, 191, 36);
    color: rgb(0, 0, 0);
    box-shadow: var(--shadow-soft, 0 2px 20px -2px rgba(251, 191, 36, 0.3));
  }

  @keyframes pulse-glow {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.02);
    }
  }
</style>
