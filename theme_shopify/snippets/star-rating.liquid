{% comment %}
  Renders a star rating
  
  Usage:
  {% render 'star-rating', rating: 4.5 %}
{% endcomment %}

{% assign rating_value = rating | default: 0 %}
{% assign full_stars = rating_value | floor %}
{% assign has_half_star = rating_value | modulo: 1 | at_least: 0.25 %}

<div class="star-rating" aria-label="Note: {{ rating_value }} sur 5">
  {% for i in (1..5) %}
    {% if i <= full_stars %}
      <svg class="star star--full" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 0l2.163 5.163L16 6.013l-4 3.887.945 5.1L8 12.163 3.055 15l.945-5.1-4-3.887 5.837-.85L8 0z"/>
      </svg>
    {% elsif i == full_stars | plus: 1 and has_half_star > 0 %}
      <svg class="star star--half" width="16" height="16" viewBox="0 0 16 16">
        <defs>
          <linearGradient id="half-{{ rating | replace: '.', '-' }}">
            <stop offset="50%" stop-color="currentColor"/>
            <stop offset="50%" stop-color="#e5e7eb"/>
          </linearGradient>
        </defs>
        <path fill="url(#half-{{ rating | replace: '.', '-' }})" d="M8 0l2.163 5.163L16 6.013l-4 3.887.945 5.1L8 12.163 3.055 15l.945-5.1-4-3.887 5.837-.85L8 0z"/>
      </svg>
    {% else %}
      <svg class="star star--empty" width="16" height="16" viewBox="0 0 16 16" fill="#e5e7eb">
        <path d="M8 0l2.163 5.163L16 6.013l-4 3.887.945 5.1L8 12.163 3.055 15l.945-5.1-4-3.887 5.837-.85L8 0z"/>
      </svg>
    {% endif %}
  {% endfor %}
</div>
