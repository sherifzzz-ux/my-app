[
  {
    "name": "theme_info",
    "theme_name": "FlawlessBeauty",
    "theme_version": "1.0.0",
    "theme_author": "FlawlessBeauty",
    "theme_documentation_url": "https://flawlessbeauty.com",
    "theme_support_url": "https://flawlessbeauty.com/support"
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "header",
        "content": "Couleurs principales"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Couleur principale (Rose)",
        "default": "#F792CC"
      },
      {
        "type": "color",
        "id": "color_primary_glow",
        "label": "Couleur principale glow",
        "default": "#FBB6DD"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur d'accent (Corail)",
        "default": "#FF9675"
      },
      {
        "type": "color",
        "id": "color_urgent",
        "label": "Couleur urgence/promo",
        "default": "#EE5A52"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Couleur succès",
        "default": "#34D399"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Couleur or premium",
        "default": "#F59E0B"
      },
      {
        "type": "header",
        "content": "Couleurs de fond"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Couleur de fond",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Couleur du texte",
        "default": "#0A0E27"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Couleur du texte secondaire",
        "default": "#6B7280"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "header",
        "content": "Polices"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Police du corps",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Police des titres",
        "default": "playfair_display_n7"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Taille de base",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "En-tête",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Largeur du logo",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 150
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Texte de bannière",
        "default": "🚀 Livraison en moins de 24h à Dakar (hors dimanches/jours fériés)"
      },
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Afficher la bannière",
        "default": true
      }
    ]
  },
  {
    "name": "Page d'accueil",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_hero_carousel",
        "label": "Afficher le carrousel hero",
        "default": true
      },
      {
        "type": "range",
        "id": "hero_autoplay_speed",
        "label": "Vitesse du carrousel (secondes)",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "show_featured_products",
        "label": "Afficher les produits mis en avant",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_category_grid",
        "label": "Afficher la grille de catégories",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_brand_logos",
        "label": "Afficher les logos des marques",
        "default": true
      }
    ]
  },
  {
    "name": "Produits",
    "settings": [
      {
        "type": "select",
        "id": "products_per_page",
        "label": "Produits par page",
        "options": [
          { "value": "16", "label": "16" },
          { "value": "32", "label": "32" },
          { "value": "48", "label": "48" }
        ],
        "default": "32"
      },
      {
        "type": "checkbox",
        "id": "show_product_badges",
        "label": "Afficher les badges promo",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Afficher l'ajout rapide au panier",
        "default": true
      },
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Ratio des images produits",
        "options": [
          { "value": "square", "label": "Carré (1:1)" },
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "landscape", "label": "Paysage (4:3)" }
        ],
        "default": "portrait"
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          { "value": "drawer", "label": "Tiroir latéral" },
          { "value": "page", "label": "Page complète" }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Seuil de livraison gratuite (CFA)",
        "default": "50000"
      }
    ]
  },
  {
    "name": "Pied de page",
    "settings": [
      {
        "type": "richtext",
        "id": "footer_about",
        "label": "Texte À propos",
        "default": "<p>Votre destination beauté de confiance pour des produits cosmétiques de qualité et des conseils experts.</p>"
      },
      {
        "type": "text",
        "id": "footer_phone",
        "label": "Téléphone",
        "default": "+221 XX XXX XX XX"
      },
      {
        "type": "text",
        "id": "footer_email",
        "label": "Email",
        "default": "contact@flawlessbeauty.sn"
      },
      {
        "type": "text",
        "id": "footer_address",
        "label": "Adresse",
        "default": "Dakar, Sénégal"
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Afficher les icônes de paiement",
        "default": true
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook",
        "label": "URL Facebook"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "URL Instagram"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "URL Twitter/X"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "URL YouTube"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "URL TikTok"
      }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      {
        "type": "image_picker",
        "id": "seo_image",
        "label": "Image par défaut"
      },
      {
        "type": "textarea",
        "id": "seo_description",
        "label": "Description par défaut"
      }
    ]
  }
]
