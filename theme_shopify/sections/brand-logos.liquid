<section class="brand-logos section-spacing">
  <div class="container">
    {% if section.settings.title %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="brand-logos__slider" x-data="{ scrolling: true }" x-init="
      const slider = $el.querySelector('.brand-logos__track');
      let position = 0;
      const speed = 1;
      
      setInterval(() => {
        if (scrolling) {
          position -= speed;
          if (Math.abs(position) >= slider.scrollWidth / 2) {
            position = 0;
          }
          slider.style.transform = `translateX(${position}px)`;
        }
      }, 30);
    ">
      <div class="brand-logos__track">
        {% for block in section.blocks %}
          <div class="brand-logo" {{ block.shopify_attributes }}>
            {% if block.settings.link %}
              <a href="{{ block.settings.link }}">
            {% endif %}
            
            {% if block.settings.image %}
              <img 
                src="{{ block.settings.image | img_url: '200x' }}" 
                alt="{{ block.settings.alt_text | default: block.settings.title | escape }}"
                loading="lazy"
              >
            {% else %}
              <span class="brand-name">{{ block.settings.title }}</span>
            {% endif %}
            
            {% if block.settings.link %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
        
        <!-- Duplicate for infinite scroll -->
        {% for block in section.blocks %}
          <div class="brand-logo" aria-hidden="true">
            {% if block.settings.link %}
              <a href="{{ block.settings.link }}" tabindex="-1">
            {% endif %}
            
            {% if block.settings.image %}
              <img 
                src="{{ block.settings.image | img_url: '200x' }}" 
                alt=""
                loading="lazy"
              >
            {% else %}
              <span class="brand-name">{{ block.settings.title }}</span>
            {% endif %}
            
            {% if block.settings.link %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logos de marques",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nos Marques Partenaires"
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nom de la marque"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texte alternatif"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logos de marques"
    }
  ]
}
{% endschema %}
