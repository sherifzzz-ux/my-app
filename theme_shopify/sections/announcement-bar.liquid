{% if settings.show_announcement and settings.announcement_text != blank %}
<div class="announcement-bar">
  <div class="container">
    <div class="announcement-bar__content">
      {{ settings.announcement_text }}
    </div>
  </div>
</div>
{% endif %}

<style>
.announcement-bar {
  background: linear-gradient(135deg, {{ settings.color_primary }}, {{ settings.color_accent }});
  color: white;
  padding: 0.75rem 1rem;
  text-align: center;
  font-size: 0.875rem;
  font-weight: 500;
}

.announcement-bar__content {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 768px) {
  .announcement-bar {
    font-size: 0.75rem;
    padding: 0.5rem 1rem;
  }
}
</style>

{% schema %}
{
  "name": "Bannière d'annonce",
  "settings": []
}
{% endschema %}
